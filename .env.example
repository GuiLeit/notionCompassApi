#Docker
COMPOSE_PROJECT_NAME=notion_compass_api

# Database
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Spring
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Notion API (Replace with your actual values)
NOTION_API_KEY=your_notion_api_key_here
NOTION_CLIENT_ID=your_client_id_here
NOTION_CLIENT_SECRET=your_client_secret_here
NOTION_REDIRECT_URI=http://localhost:8080/notion/auth/callback
NOTION_WEBHOOK_SECRET=webhook_secret_here

# JWT
JWT_SECRET=my_jwt_secret_key
JWT_EXPIRATION_HOURS=72

APP_EXTENSION_ID=your_app_extension_id_here